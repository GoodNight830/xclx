<view class="page">
  <view class="page-header">
    <view>
      <view class="page-title">个人数据</view>
      <view class="page-subtitle">你的训练全景：模块分布、历史记录与收藏</view>
    </view>
  </view>

  <!-- 概览卡 -->
  <view class="section">
    <view class="section-title">概览</view>
    <view class="stat-grid">
      <view class="stat">
        <view class="stat-label">📝 总题数</view>
        <view class="stat-value stat-value-sm">{{total ? total.questionCount : '—'}}</view>
      </view>
      <view class="stat">
        <view class="stat-label">🏁 训练组</view>
        <view class="stat-value stat-value-sm">{{total ? total.sessionCount : '—'}}</view>
      </view>
      <view class="stat">
        <view class="stat-label">🎯 正确率</view>
        <view class="stat-value stat-value-sm">{{total && total.questionCount ? total.accuracyLabel : '—'}}</view>
      </view>
      <view class="stat">
        <view class="stat-label">📕 错题</view>
        <view class="stat-value stat-value-sm">{{wrongQuestionCount}}</view>
      </view>
      <view class="stat">
        <view class="stat-label">⭐ 收藏</view>
        <view class="stat-value stat-value-sm">{{bookmarkCount}}</view>
      </view>
    </view>
  </view>

  <!-- 模块分布饼状图 -->
  <view class="section">
    <view class="section-title">模块训练分布</view>
    <view wx:if="{{!pieHasData}}" class="alert alert-info">还没有训练记录，完成一组训练后这里会显示各模块占比。</view>
    <view wx:else class="card" style="display: flex; align-items: center; flex-wrap: wrap">
      <canvas type="2d" id="pieChart" class="pie-canvas" style="flex-shrink: 0"></canvas>
      <view class="list" style="flex: 1; min-width: 300rpx; margin-left: 24rpx">
        <view wx:for="{{pieSegments}}" wx:key="module" class="list-item">
          <view class="list-item-main">
            <view class="row" style="align-items: center">
              <text class="pie-dot" style="background: {{item.color}}"></text>
              <text class="bold">{{item.label}}</text>
            </view>
          </view>
          <text class="mono text-sm text-muted">{{item.questionCount}} 题 · {{item.percentLabel}}</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 训练记录 -->
  <view class="section">
    <view class="section-title">训练记录</view>

    <view style="display: flex; margin-bottom: 16rpx">
      <view class="field" style="flex: 1; margin: 0">
        <view class="field-label">模块</view>
        <picker range="{{moduleOptions}}" range-key="label" value="{{moduleFilterIndex}}" bindchange="switchModule">
          <view class="input" hover-class="press-light">{{moduleFilterLabel}}</view>
        </picker>
      </view>
      <view class="field" style="flex: 1; margin: 0 0 0 16rpx">
        <view class="field-label">日期</view>
        <picker range="{{dateOptions}}" value="{{dateFilterIndex}}" bindchange="switchDate">
          <view class="input" hover-class="press-light">{{dateFilter ? dateFilter : '全部日期'}}</view>
        </picker>
      </view>
    </view>

    <view class="tabs">
      <button
        wx:for="{{ranges}}"
        wx:key="key"
        class="tab {{range === item.key ? 'active' : ''}}"
        data-key="{{item.key}}"
        bindtap="switchRange"
      >{{item.label}}</button>
    </view>

    <view wx:if="{{summary}}" class="stat-grid" style="margin-bottom: 20rpx">
      <view class="stat">
        <view class="stat-label">训练组数</view>
        <view class="stat-value stat-value-sm">{{summary.sessionCount}}</view>
      </view>
      <view class="stat">
        <view class="stat-label">题目数</view>
        <view class="stat-value stat-value-sm">{{summary.questionCount}}</view>
      </view>
      <view class="stat">
        <view class="stat-label">正确率</view>
        <view class="stat-value stat-value-sm">{{summary.accuracyLabel}}</view>
      </view>
      <view class="stat">
        <view class="stat-label">平均单题</view>
        <view class="stat-value stat-value-sm">{{summary.avgElapsedLabel}}</view>
      </view>
    </view>

    <view wx:if="{{!hasRecords}}" class="empty">还没有训练记录，完成一组训练后这里会按天显示。</view>

    <view wx:for="{{visibleDaily}}" wx:key="date" class="card section">
      <view class="row-between">
        <view class="card-title">{{item.dateLabel}}</view>
        <view class="text-xs text-muted mono">{{item.date}}</view>
      </view>
      <view class="card-subtitle">训练 {{item.sessionCount}} 组 / 共 {{item.questionCount}} 题 · 正确率 {{item.accuracyLabel}}</view>

      <view class="list" style="margin-top: 16rpx">
        <view wx:for="{{item.sessions}}" wx:for-item="session" wx:key="id" class="list-item" hover-class="press-light">
          <view class="list-item-main" data-id="{{session.id}}" bindtap="toggleSession">
            <view class="row">
              <text class="badge badge-muted">{{session.mode === 'speed' ? '竞速' : '训练'}}</text>
              <text class="mono text-sm">{{session.correctCount}}/{{session.answeredCount}}</text>
            </view>
            <view class="list-item-meta">{{session.startedAt}}</view>
          </view>
          <text class="collapse-chevron {{expandedSessionId === session.id ? 'open' : ''}}" style="margin-left: 8rpx"></text>
        </view>

        <view wx:if="{{expandedSessionId === session.id}}" style="padding-left: 16rpx; margin-top: 8rpx">
          <view wx:for="{{sessionRecords[session.id]}}" wx:for-item="record" wx:key="id" class="list-item">
            <view class="list-item-main">
              <view class="row">
                <text class="text-sm">{{record.question}}</text>
                <text class="{{record.correct ? 'text-success bold' : 'text-danger bold'}}">{{record.correct ? '✓' : '✕'}}</text>
              </view>
              <view wx:if="{{!record.correct}}" class="list-item-meta mono">答案 {{record.userAnswer !== null && record.userAnswer !== undefined ? record.userAnswer : '—'}} → {{record.correctAnswer}}</view>
            </view>
          </view>
        </view>
      </view>
    </view>

    <view wx:if="{{hasMore}}" class="text-center" style="margin-top: 8rpx">
      <button class="btn btn-outline btn-block" bindtap="loadMore">加载更多（还有 {{filteredDailyLength - visibleDaily.length}} 天）</button>
    </view>
  </view>

  <!-- 收藏列表 -->
  <view class="section">
    <view class="row-between">
      <view class="section-title" style="margin: 0">我的收藏</view>
      <text class="text-xs text-muted">{{bookmarks.length}} 题</text>
    </view>
    <view wx:if="{{bookmarks.length === 0}}" class="alert alert-info" style="margin-top: 16rpx">还没有收藏题目。在训练结果或训练记录的题目里点「☆ 收藏」即可收藏。</view>
    <view wx:else class="card" style="margin-top: 16rpx">
      <view class="list">
        <view wx:for="{{bookmarks}}" wx:key="id" class="list-item" style="align-items: flex-start">
          <view class="list-item-main">
            <view class="row">
              <text class="question-text" style="font-size: 28rpx">{{item.question}}</text>
              <text class="badge badge-muted">{{item.moduleLabel}}</text>
            </view>
            <view wx:if="{{item.note}}" class="list-item-meta">📝 {{item.note}}</view>
          </view>
        </view>
      </view>
    </view>
  </view>
</view>
