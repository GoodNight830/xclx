<view class="page">
  <view class="page-header">
    <view>
      <view class="page-title">正负运算</view>
      <view class="page-subtitle">模块详情 · 也可直接开始训练</view>
    </view>
  </view>

  <view class="card section">
    <view class="row-between">
      <view class="card-title">当前配置</view>
      <button class="btn btn-ghost btn-sm" bindtap="goSettings">修改设置</button>
    </view>
    <view class="stat-grid" style="margin-top: 20rpx">
      <view class="stat">
        <view class="stat-label">默认模式</view>
        <view class="stat-value stat-value-sm">{{settings.defaultMode === 'speed' ? '竞速模式' : '训练模式'}}</view>
      </view>
      <view class="stat">
        <view class="stat-label">题目数量</view>
        <view class="stat-value stat-value-sm">{{settings.defaultQuestionCount}} 题</view>
      </view>
    </view>
  </view>

  <view class="card section">
    <view class="row-between">
      <view class="card-title">开始训练</view>
      <text class="badge badge-success">{{modeLabel}}</text>
    </view>
    <view class="tabs" style="margin-bottom: 0; margin-top: 20rpx">
      <button
        class="tab {{settings.defaultMode === 'training' ? 'active' : ''}}"
        data-mode="training"
        bindtap="switchMode"
      >练习模式</button>
      <button
        class="tab {{settings.defaultMode === 'speed' ? 'active' : ''}}"
        data-mode="speed"
        bindtap="switchMode"
      >竞速模式</button>
    </view>
    <view class="card-subtitle" style="margin-top: 16rpx">{{modeDescription}}</view>
    <button class="btn btn-primary btn-lg btn-block" style="margin-top: 20rpx" bindtap="start">开始训练（{{modeLabel}}）</button>
  </view>

  <view class="alert alert-info section">
    <view class="text-sm">本模块为纯练习，不参与 AI 解读与能力诊断。</view>
  </view>
</view>
