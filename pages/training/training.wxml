<view class="page training-page">
  <!-- 顶部：进度（提前离开用系统返回键，会提示是否放弃） -->
  <view class="training-header">
    <view class="text-sm text-muted">
      <text class="bold">{{moduleTitle}}</text>
      <text wx:if="{{isSpeed}}"> · 第 {{displayIndex}}/{{questionCount}} 题</text>
      <text wx:else> · 第 {{displayIndex}} 题</text>
    </view>
  </view>

  <!-- 题目 + 答案：居中成组，答案直接跟在算式下面 -->
  <view class="question-area">
    <view class="question-center">
      <view class="question-big">{{questionText}}</view>
      <view class="answer-line {{feedback && !feedback.correct ? 'answer-wrong' : ''}}">
        <text class="answer-eq">＝</text>
        <text wx:if="{{input}}" class="answer-value">{{input}}</text>
        <text wx:else class="answer-cursor">_</text>
      </view>
    </view>
  </view>

  <!-- 反馈（仅训练模式） -->
  <view wx:if="{{awaitingContinue}}" class="feedback-area">
    <view wx:if="{{feedback.correct}}" class="alert alert-success">
      ✓ 正确
      <text wx:if="{{feedback.errorRate !== null}}" class="text-sm">（误差 {{feedback.errorRate}}%）</text>
    </view>
    <view wx:else class="alert alert-danger">
      <view>✕ 错误</view>
      <view class="text-sm">正确答案：{{feedback.correctAnswer}}</view>
      <view wx:if="{{feedback.errorRate !== null}}" class="text-sm">误差 {{feedback.errorRate}}%</view>
    </view>
    <button class="btn btn-primary btn-block" style="margin-top: 20rpx" bindtap="continueNext">继续</button>
  </view>

  <!-- 数字键盘（3 列布局：功能行 + 数字区 + 底行） -->
  <view class="keypad-wrap">
    <view class="keypad">
      <view class="key key-fn" hover-class="key-active" bindtap="restartSession">重开</view>
      <view class="key key-fn" data-key="clear" hover-class="key-active" bindtap="onKeyTap">清空</view>
      <view class="key key-fn" data-key="del" hover-class="key-active" bindtap="onKeyTap">退格</view>
      <view class="key" data-key="1" hover-class="key-active" bindtap="onKeyTap">1</view>
      <view class="key" data-key="2" hover-class="key-active" bindtap="onKeyTap">2</view>
      <view class="key" data-key="3" hover-class="key-active" bindtap="onKeyTap">3</view>
      <view class="key" data-key="4" hover-class="key-active" bindtap="onKeyTap">4</view>
      <view class="key" data-key="5" hover-class="key-active" bindtap="onKeyTap">5</view>
      <view class="key" data-key="6" hover-class="key-active" bindtap="onKeyTap">6</view>
      <view class="key" data-key="7" hover-class="key-active" bindtap="onKeyTap">7</view>
      <view class="key" data-key="8" hover-class="key-active" bindtap="onKeyTap">8</view>
      <view class="key" data-key="9" hover-class="key-active" bindtap="onKeyTap">9</view>
      <view wx:if="{{allowNegative}}" class="key" data-key="neg" hover-class="key-active" bindtap="onKeyTap">+/−</view>
      <view wx:else class="key" data-key="0" hover-class="key-active" bindtap="onKeyTap">0</view>
      <view class="key" data-key="." hover-class="key-active" bindtap="onKeyTap">.</view>
      <view class="key key-submit" hover-class="key-active" bindtap="submit">确认</view>
    </view>
  </view>
</view>
