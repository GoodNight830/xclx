/* 训练页：满屏 flex 布局，键盘吸底（题目区弹性占位） */
.training-page {
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
  min-height: 100vh;
  padding-bottom: 40rpx;
}

.training-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
  flex-shrink: 0;
}

/* 题目区：flex:1 弹性占据键盘上方空间，内容垂直居中 */
.question-area {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 200rpx;
  padding: 20rpx 0;
}

.question-big {
  font-size: 60rpx;
  text-align: center;
  word-break: break-all;
  line-height: 1.4;
}

.answer-display {
  background: #ffffff;
  border-radius: 20rpx;
  padding: 24rpx 28rpx;
  text-align: right;
  font-size: 48rpx;
  font-weight: 700;
  min-height: 88rpx;
  box-sizing: border-box;
  box-shadow: 0 2rpx 12rpx rgba(31, 36, 48, 0.04);
  margin-bottom: 20rpx;
  color: #1f2430;
  word-break: break-all;
  flex-shrink: 0;
}
.answer-display .placeholder {
  color: #c0c6d2;
  font-weight: 400;
}
.answer-wrong {
  color: #ef4444;
}

.feedback-area {
  margin-bottom: 20rpx;
  flex-shrink: 0;
}

/* 键盘吸底：margin-top:auto 把键盘推到页面底部 */
.keypad-wrap {
  margin-top: auto;
  flex-shrink: 0;
}
