/* 训练页：满屏 flex 布局，键盘吸底（题目区弹性占位） */
.training-page {
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
  min-height: 100vh;
  padding-bottom: 40rpx;
}

.training-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
  flex-shrink: 0;
}

/* 结束按钮：ghost 文字太隐蔽，加一点边界让它看起来可点 */
.end-btn {
  border: 2rpx solid #e6e9f0;
  border-radius: 12rpx;
  color: #8a93a6;
}

/* 题目区：flex:1 弹性占据键盘上方空间，内容垂直居中 */
.question-area {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 200rpx;
  padding: 20rpx 0;
}

/* 题目 + 答案成组居中：答案就是算式的「＝」后面，不再像输入框 */
.question-center {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.question-big {
  font-size: 60rpx;
  text-align: center;
  word-break: break-all;
  line-height: 1.4;
}

.answer-line {
  margin-top: 24rpx;
  display: flex;
  align-items: baseline;
  justify-content: center;
  min-height: 96rpx;
  max-width: 100%;
}
.answer-eq {
  font-size: 48rpx;
  color: #8a93a6;
  margin-right: 16rpx;
  flex-shrink: 0;
}
.answer-value {
  font-size: 76rpx;
  font-weight: 700;
  color: #2f9e6b;
  border-bottom: 6rpx solid #bfe6d2;
  padding: 0 16rpx;
  word-break: break-all;
  line-height: 1.3;
}
.answer-cursor {
  font-size: 76rpx;
  font-weight: 700;
  color: #c0c6d2;
  border-bottom: 6rpx solid #dfe3ea;
  padding: 0 24rpx;
  line-height: 1.3;
}
/* 答错的瞬间：整组答案变红 */
.answer-wrong .answer-value,
.answer-wrong .answer-cursor {
  color: #ef4444;
  border-bottom-color: #fbc5c5;
}

.feedback-area {
  margin-bottom: 20rpx;
  flex-shrink: 0;
}

/* 键盘吸底：margin-top:auto 把键盘推到页面底部 */
.keypad-wrap {
  margin-top: auto;
  flex-shrink: 0;
}
