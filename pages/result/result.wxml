<view class="page">
  <view wx:if="{{session}}">
    <!-- 等级 -->
    <view class="card section" style="text-align: center">
      <view class="grade-badge {{gradeClass}}">{{gradeLabel}}</view>
      <view class="card-subtitle" style="margin-top: 16rpx">{{gradeDescription}}</view>
    </view>

    <!-- 成绩统计 -->
    <view class="section">
      <view class="section-title">成绩统计</view>
      <view class="stat-grid">
        <view class="stat">
          <view class="stat-label">正确 / 总题</view>
          <view class="stat-value">{{session.correctCount}}/{{session.answeredCount}}</view>
        </view>
        <view class="stat">
          <view class="stat-label">正确率</view>
          <view class="stat-value">{{accuracy}}</view>
        </view>
        <view class="stat">
          <view class="stat-label">总用时</view>
          <view class="stat-value stat-value-sm">{{totalElapsedLabel}}</view>
        </view>
        <view class="stat">
          <view class="stat-label">平均单题</view>
          <view class="stat-value stat-value-sm">{{avgElapsedLabel}}</view>
        </view>
      </view>
    </view>

    <!-- 逐题回顾 -->
    <view class="section">
      <view class="section-title">逐题回顾</view>
      <view class="card">
        <view class="list">
          <view wx:for="{{records}}" wx:key="id" class="list-item record-item">
            <view class="list-item-main">
              <view class="record-head">
                <text class="record-index">{{index + 1}}.</text>
                <text class="record-question">{{item.question}}</text>
                <text class="record-mark {{item.correct ? 'record-mark-ok' : 'record-mark-bad'}}">{{item.correct ? '✓' : '✕'}}</text>
              </view>

              <view class="record-meta">
                <text class="record-meta-item">你的答案 <text class="mono {{item.correct ? '' : 'text-danger'}}">{{item.userAnswerLabel}}</text></text>
                <text wx:if="{{!item.correct}}" class="record-meta-item">正确答案 <text class="mono text-success">{{item.correctAnswerLabel}}</text></text>
              </view>
            </view>
            <button class="btn btn-ghost btn-sm record-star" data-index="{{index}}" bindtap="toggleBookmark">
              {{bookmarkStates[item.id] ? '★' : '☆'}}
            </button>
          </view>
        </view>
      </view>
    </view>

    <!-- 操作 -->
    <view class="topic-grid" style="margin-top: 20rpx">
      <button class="btn topic-btn btn-primary" bindtap="trainAgain">再来一组</button>
      <button class="btn topic-btn btn-outline" bindtap="goHome">返回首页</button>
    </view>
  </view>
</view>
