/* 训练结果页：等级徽章（独立配色，不复用小徽章类） */
.grade-badge {
  display: inline-block;
  font-size: 56rpx;
  font-weight: 700;
  padding: 16rpx 56rpx;
  border-radius: 24rpx;
  line-height: 1.3;
}
.grade-excellent {
  background: #eaf7f0;
  color: #2f9e6b;
}
.grade-good {
  background: #eef4ff;
  color: #4f7cff;
}
.grade-pass {
  background: #fef4e6;
  color: #f59e0b;
}
.grade-encourage {
  background: #eef1f6;
  color: #8a93a6;
}
