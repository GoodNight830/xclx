/* 训练结果页：等级徽章（独立配色，不复用小徽章类） */
.grade-badge {
  display: inline-block;
  font-size: 56rpx;
  font-weight: 700;
  padding: 16rpx 56rpx;
  border-radius: 24rpx;
  line-height: 1.3;
}
.grade-excellent {
  background: #eaf7f0;
  color: #2f9e6b;
}
.grade-good {
  background: #eef4ff;
  color: #4f7cff;
}
.grade-pass {
  background: #fef4e6;
  color: #f59e0b;
}
.grade-encourage {
  background: #eef1f6;
  color: #8a93a6;
}

/* ---------- 逐题回顾 ---------- */
.record-item {
  align-items: flex-start;
}
.record-head {
  display: flex;
  align-items: flex-start;
  width: 100%;
}
.record-index {
  flex-shrink: 0;
  width: 44rpx;
  font-size: 24rpx;
  color: #8a93a6;
  line-height: 1.7;
}
.record-question {
  flex: 1;
  min-width: 0;
  font-size: 28rpx;
  font-weight: 600;
  color: #1f2430;
  word-break: break-all;
  line-height: 1.5;
}
.record-mark {
  flex-shrink: 0;
  margin-left: 12rpx;
  font-size: 28rpx;
  font-weight: 700;
  line-height: 1.5;
}
.record-mark-ok {
  color: #2f9e6b;
}
.record-mark-bad {
  color: #ef4444;
}
.record-meta {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #6b7280;
  line-height: 1.6;
}
/* 微信小程序不支持 flex gap，用 margin 代替 */
.record-meta-item {
  margin-right: 28rpx;
}
.record-star {
  flex-shrink: 0;
  margin-left: 12rpx;
}
