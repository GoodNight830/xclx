/* 设置页样式 —— 独立重写版
 *
 * 设计原则：
 * 1. 完全不依赖 app.wxss 的 .btn / .card / .field 规则，避免被原生组件默认样式干扰。
 * 2. 不使用 CSS Grid、不使用 flex gap、不使用结构性伪类（小程序不支持）。
 * 3. 网格一律 flex + flex-wrap + 百分比宽度 + 负 margin。
 * 4. 可点击区域全部由 <view> 承担（微信 <button> 自带 margin:auto 等基础样式，易错位）。
 */

.st-page {
  box-sizing: border-box;
  padding: 24rpx 24rpx 60rpx;
}

/* ---------- 页头 ---------- */
.st-head {
  padding: 8rpx 0 28rpx;
}
.st-title {
  font-size: 40rpx;
  font-weight: 700;
  line-height: 1.3;
  color: #1f2430;
}
.st-sub {
  font-size: 24rpx;
  color: #8a93a6;
  margin-top: 6rpx;
}

/* ---------- 区块 / 卡片 ---------- */
.st-sec {
  margin-bottom: 32rpx;
}
.st-sec-title {
  font-size: 28rpx;
  font-weight: 700;
  color: #4a5264;
  margin-bottom: 16rpx;
  padding-left: 8rpx;
}
.st-card {
  box-sizing: border-box;
  background: #ffffff;
  border-radius: 20rpx;
  /* 上下必须留内边距：否则卡片里最后一个按钮直接贴住底部圆角，
   * 视觉上像「顶出框」（此前 测试连接 / 清空所有训练数据 就是这个情况） */
  padding: 6rpx 28rpx 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(31, 36, 48, 0.05);
  overflow: hidden;
}

/* ---------- 通用行 ---------- */
.st-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  box-sizing: border-box;
  width: 100%;
  padding: 22rpx 0;
  border-bottom: 2rpx solid #f0f2f7;
}
.st-row-noborder {
  border-bottom: none;
}
/* 行式按压态：跟随 .press-row 的规范（左右各外扩 16rpx + 14rpx 圆角），
 * 这里必须写在页面样式里才能覆盖 .st-row 的 padding / border。 */
.st-row-hover {
  background: #eaf3ee;
  border-radius: 14rpx;
  margin-left: -16rpx;
  margin-right: -16rpx;
  padding-left: 16rpx;
  padding-right: 16rpx;
  border-bottom-color: transparent;
}
.st-row-label {
  font-size: 28rpx;
  color: #1f2430;
  line-height: 1.5;
}
.st-row-sub {
  font-size: 22rpx;
  color: #8a93a6;
  margin-top: 4rpx;
  line-height: 1.5;
}
.st-row-value {
  font-size: 28rpx;
  color: #2f9e6b;
  display: flex;
  align-items: center;
  flex-shrink: 0;
  margin-left: 20rpx;
}
/* 右箭头 */
.st-arrow {
  display: inline-block;
  width: 14rpx;
  height: 14rpx;
  border-right: 3rpx solid #b6bcc9;
  border-bottom: 3rpx solid #b6bcc9;
  transform: rotate(-45deg);
  margin-left: 12rpx;
}

/* ---------- 滑块行 ---------- */
.st-slider-row {
  box-sizing: border-box;
  width: 100%;
  padding: 24rpx 0 12rpx;
  border-bottom: 2rpx solid #f0f2f7;
}
.st-slider-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 4rpx;
}
.st-slider-num {
  font-size: 26rpx;
  font-weight: 700;
  color: #2f9e6b;
}

/* ---------- 表单项 ---------- */
.st-field {
  box-sizing: border-box;
  width: 100%;
  padding: 22rpx 0;
  border-bottom: 2rpx solid #f0f2f7;
}
.st-field-label {
  font-size: 26rpx;
  color: #4a5264;
  font-weight: 600;
  margin-bottom: 14rpx;
}
.st-input {
  box-sizing: border-box;
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  padding: 0 24rpx;
  border-radius: 14rpx;
  border: 2rpx solid #e6e9f0;
  background: #fbfcfb;
  font-size: 28rpx;
  color: #1f2430;
}
.st-placeholder {
  color: #b6bcc9;
  font-size: 28rpx;
}
/* 输入框 + 右侧「拉取模型」小按钮 */
.st-input-row {
  display: flex;
  align-items: center;
}
.st-input-grow {
  flex: 1;
  width: auto;
  min-width: 0;
}
.st-fetch {
  flex-shrink: 0;
  margin-left: 16rpx;
  height: 88rpx;
  line-height: 88rpx;
  padding: 0 26rpx;
  border-radius: 14rpx;
  border: 2rpx solid #bfe6d2;
  background: #ffffff;
  color: #2f9e6b;
  font-size: 26rpx;
  font-weight: 600;
  white-space: nowrap;
}
.st-fetch-hover {
  background: #eaf3ee;
}
.st-fetch-busy {
  color: #8a93a6;
  border-color: #e6e9f0;
  background: #f7f8fa;
}

/* 已拉取的模型：点选下拉 */
.st-select {
  display: flex;
  align-items: center;
  justify-content: space-between;
  box-sizing: border-box;
  width: 100%;
  height: 88rpx;
  padding: 0 24rpx;
  margin-top: 14rpx;
  border-radius: 14rpx;
  background: #f6f8f6;
  border: 2rpx solid #e6e9f0;
}
.st-select-hover {
  background: #eaf3ee;
}
.st-select-text {
  flex: 1;
  font-size: 28rpx;
  color: #1f2430;
  word-break: break-all;
}

/* 表单项下方的轻量说明文字（不带分隔线，区别于 .st-hint） */
.st-field-hint {
  font-size: 22rpx;
  color: #8a93a6;
  line-height: 1.6;
  margin-top: 10rpx;
}

/* ---------- 服务商预设 ---------- */
.st-chips {
  display: flex;
  flex-wrap: wrap;
  margin-right: -12rpx;
  margin-bottom: -12rpx;
}
.st-chip {
  box-sizing: border-box;
  height: 64rpx;
  line-height: 64rpx;
  padding: 0 26rpx;
  margin-right: 12rpx;
  margin-bottom: 12rpx;
  border-radius: 32rpx;
  font-size: 26rpx;
  color: #4a5264;
  background: #f2f4f8;
}
.st-chip-on {
  background: #eaf3ee;
  color: #2f9e6b;
  font-weight: 600;
  border: 2rpx solid #bfe6d2;
}
.st-chip-hover {
  background: #e6eaef;
}
.st-chip-on.st-chip-hover {
  background: #dcefe4;
}

/* ---------- 实际请求地址预览 ---------- */
.st-endpoint {
  margin-top: 14rpx;
  padding: 16rpx 20rpx;
  border-radius: 12rpx;
  background: #f6f8f6;
}
.st-endpoint-label {
  font-size: 22rpx;
  color: #8a93a6;
  margin-bottom: 6rpx;
}
.st-endpoint-url {
  font-size: 24rpx;
  color: #2f9e6b;
  word-break: break-all;
  line-height: 1.5;
}

/* ---------- 说明文字 ---------- */
.st-hint {
  font-size: 22rpx;
  color: #8a93a6;
  line-height: 1.6;
  padding: 22rpx 0;
  border-bottom: 2rpx solid #f0f2f7;
}
.st-footnote {
  font-size: 22rpx;
  color: #8a93a6;
  text-align: center;
  margin-top: 20rpx;
}

/* ---------- 数据统计（4 列） ---------- */
.st-count-box {
  display: flex;
  flex-wrap: wrap;
  /* 左右对称外扩，抵消每个单元格的 margin-right，
   * 否则分隔线只向右多出 16rpx、左侧不齐（视觉上像歪出框） */
  margin-left: -16rpx;
  margin-right: -16rpx;
  padding: 28rpx 0 8rpx;
  border-bottom: 2rpx solid #f0f2f7;
}
.st-count {
  box-sizing: border-box;
  width: calc(25% - 16rpx);
  margin-right: 16rpx;
  margin-bottom: 20rpx;
  text-align: center;
}
.st-count-num {
  font-size: 34rpx;
  font-weight: 700;
  color: #1f2430;
  line-height: 1.3;
}
.st-count-label {
  font-size: 22rpx;
  color: #8a93a6;
  margin-top: 4rpx;
}

/* ---------- 操作区（view 实现，规避原生 button 默认样式） ---------- */
.st-act {
  box-sizing: border-box;
  width: 100%;
  height: 96rpx;
  line-height: 96rpx;
  text-align: center;
  border-radius: 16rpx;
  font-size: 30rpx;
  font-weight: 600;
  margin-top: 20rpx;
}
.st-act-primary {
  background: #2f9e6b;
  color: #ffffff;
}
.st-act-outline {
  background: #ffffff;
  color: #2f9e6b;
  border: 2rpx solid #bfe6d2;
}
.st-act-danger {
  background: #fdecec;
  color: #ef4444;
}

/* 带圆角的按钮：形状由 .st-act 提供已是 16rpx，这里只换底色 / 淡化 */
.st-act-primary-hover { opacity: 0.72; }
.st-act-outline-hover { background: #eaf3ee; }
.st-act-danger-hover { background: #fbdcdc; }

.st-act-foot {
  margin-top: 40rpx;
}
