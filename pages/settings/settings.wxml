<!--
  设置页 UI（按小程序规范重写）

  要点：
  1. 所有可点击区域改用 <view> 实现，不再依赖原生 <button>——微信 button 自带
     margin:auto / 固定尺寸等基础样式，是此前布局异常的根源。
  2. 布局全部写在本地 settings.wxss，不复用 app.wxss 的 .btn / .card 规则。
  3. 每个可点击元素都带 hover-class，保证按压反馈。
-->
<view class="st-page">

  <view class="st-head">
    <view class="st-title">设置</view>
    <view class="st-sub">训练参数、薄弱点与 AI 配置</view>
  </view>

  <!-- ============ 训练参数 ============ -->
  <view class="st-sec">
    <view class="st-sec-title">训练参数</view>
    <view class="st-card">

      <picker range="{{modeOptions}}" value="{{modeIndex}}" bindchange="onModeChange">
        <view class="st-row" hover-class="st-row-hover">
          <view>
            <view class="st-row-label">默认模式</view>
            <view class="st-row-sub">开始训练时默认使用的模式</view>
          </view>
          <view class="st-row-value">{{modeLabel}}<text class="st-arrow"></text></view>
        </view>
      </picker>

      <view class="st-slider-row">
        <view class="st-slider-head">
          <view class="st-row-label">默认题目数量</view>
          <view class="st-slider-num">{{questionCount}} 题</view>
        </view>
        <slider min="1" max="100" step="1" value="{{questionCount}}" bindchange="onQuestionCountChange" activeColor="#2f9e6b" block-size="22" show-value="{{false}}" />
      </view>

      <view class="st-slider-row st-row-noborder">
        <view class="st-slider-head">
          <view class="st-row-label">默认允许误差</view>
          <view class="st-slider-num">{{allowedErrorRate}}%</view>
        </view>
        <slider min="0" max="20" step="0.5" value="{{allowedErrorRate}}" bindchange="onErrorRateChange" activeColor="#2f9e6b" block-size="22" show-value="{{false}}" />
      </view>

    </view>
  </view>

  <!-- ============ 薄弱点分析 ============ -->
  <view class="st-sec">
    <view class="st-sec-title">薄弱点分析</view>
    <view class="st-card">

      <view class="st-row" hover-class="st-row-hover">
        <view>
          <view class="st-row-label">启用薄弱点定向强化</view>
          <view class="st-row-sub">提高易错除数范围的出题比例</view>
        </view>
        <switch checked="{{weakEnable}}" bindchange="onWeakEnableChange" color="#2f9e6b" />
      </view>

      <view class="st-slider-row">
        <view class="st-slider-head">
          <view class="st-row-label">最小样本数</view>
          <view class="st-slider-num">{{minSampleCount}} 题</view>
        </view>
        <slider min="5" max="50" step="1" value="{{minSampleCount}}" bindchange="onMinSampleChange" activeColor="#2f9e6b" block-size="22" show-value="{{false}}" />
      </view>

      <view class="st-slider-row">
        <view class="st-slider-head">
          <view class="st-row-label">最小错误数</view>
          <view class="st-slider-num">{{minErrorCount}} 题</view>
        </view>
        <slider min="1" max="20" step="1" value="{{minErrorCount}}" bindchange="onMinErrorChange" activeColor="#2f9e6b" block-size="22" show-value="{{false}}" />
      </view>

      <view class="st-slider-row st-row-noborder">
        <view class="st-slider-head">
          <view class="st-row-label">强化出题占比上限</view>
          <view class="st-slider-num">{{maxReinforcementRatio}}%</view>
        </view>
        <slider min="0" max="90" step="5" value="{{maxReinforcementRatio}}" bindchange="onMaxRatioChange" activeColor="#2f9e6b" block-size="22" show-value="{{false}}" />
      </view>

    </view>
  </view>

  <!-- ============ AI 解读 ============ -->
  <view class="st-sec">
    <view class="st-sec-title">AI 解读</view>
    <view class="st-card">

      <view class="st-row" hover-class="st-row-hover">
        <view>
          <view class="st-row-label">启用 AI 解读</view>
          <view class="st-row-sub">关闭后各页面不再展示 AI 相关入口</view>
        </view>
        <switch checked="{{aiEnabled}}" bindchange="onAiEnabledChange" color="#2f9e6b" />
      </view>

      <block wx:if="{{aiEnabled}}">
        <!-- 服务商预设：手填地址最容易写错，选一个即可自动填好地址与模型 -->
        <view class="st-field">
          <view class="st-field-label">服务商</view>
          <view class="st-chips">
            <view
              wx:for="{{providers}}"
              wx:key="key"
              class="st-chip {{item.key === aiProvider ? 'st-chip-on' : ''}}"
              data-key="{{item.key}}"
              bindtap="pickProvider"
              hover-class="st-chip-hover"
            >{{item.label}}</view>
          </view>
          <view class="st-hint">选好后仍可自行修改下面的地址和模型。</view>
        </view>

        <view class="st-field">
          <view class="st-field-label">接口地址</view>
          <input class="st-input" value="{{aiBaseUrl}}" bindinput="onAiBaseUrlInput" placeholder="https://api.deepseek.com" placeholder-class="st-placeholder" />
          <view class="st-endpoint">
            <view class="st-endpoint-label">实际请求地址</view>
            <view class="st-endpoint-url">{{aiEndpoint || '（请先填写接口地址）'}}</view>
          </view>
          <view wx:if="{{aiUrlError}}" class="st-hint" style="color: #ef4444">{{aiUrlError}}</view>
        </view>

        <view class="st-field">
          <view class="st-field-label">API Key</view>
          <input class="st-input" value="{{aiApiKey}}" bindinput="onAiApiKeyInput" bindblur="onAiApiKeyBlur" password placeholder="sk-..." placeholder-class="st-placeholder" />
          <view class="st-field-hint">填完 Key 后会自动拉取可用模型（也可以手动点下方「拉取模型」）。</view>
        </view>

        <view class="st-field">
          <view class="st-field-label">模型名称</view>
          <view class="st-input-row">
            <input class="st-input st-input-grow" value="{{aiModel}}" bindinput="onAiModelInput" placeholder="deepseek-flash" placeholder-class="st-placeholder" />
            <view class="st-fetch {{modelLoading ? 'st-fetch-busy' : ''}}" hover-class="st-fetch-hover" bindtap="loadModels">
              {{modelLoading ? '拉取中…' : '拉取模型'}}
            </view>
          </view>

          <picker wx:if="{{modelList.length}}" range="{{modelList}}" value="{{modelIndex}}" bindchange="pickModel">
            <view class="st-select" hover-class="st-select-hover">
              <view class="st-select-text">{{aiModel ? aiModel : '点此选择模型'}}</view>
              <text class="st-arrow"></text>
            </view>
          </picker>

          <view class="st-field-hint">
            {{modelList.length ? '共 ' + modelList.length + ' 个可用模型，点上方一栏可直接切换。' : '先填 API Key，再点「拉取模型」，会自动列出该 Key 可用的全部模型，不用手填。'}}
          </view>
        </view>

        <view class="st-row" hover-class="st-row-hover">
          <view>
            <view class="st-row-label">同意发送聚合统计</view>
            <view class="st-row-sub">仅发送聚合数据，不发送逐题答案（AI 诊断必须先打开）</view>
          </view>
          <switch checked="{{aiConsent}}" bindchange="onAiConsentChange" color="#2f9e6b" />
        </view>

        <view class="st-slider-row st-row-noborder">
          <view class="st-slider-head">
            <view class="st-row-label">最大输出量</view>
            <view class="st-slider-num">{{aiMaxTokens}} tokens</view>
          </view>
          <slider min="300" max="8000" step="100" value="{{aiMaxTokens}}" bindchange="onAiMaxTokensChange" activeColor="#2f9e6b" block-size="22" show-value="{{false}}" />
          <view class="st-field-hint">AI 报告（含思考型模型的推理）超过该上限会被截断。遇到「JSON 不完整 / 被截断」提示时调高即可。</view>
        </view>

        <view class="st-hint">API Key 仅保存在本机，不会随任何导出文件外泄。</view>

        <view class="st-act st-act-outline" hover-class="st-act-outline-hover" bindtap="testAi">
          {{testing ? '测试中…' : '测试连接'}}
        </view>
      </block>

    </view>
  </view>

  <!-- ============ 数据管理 ============ -->
  <view class="st-sec">
    <view class="st-sec-title">数据管理</view>
    <view class="st-card">

      <view wx:if="{{dataCounts}}" class="st-count-box">
        <view class="st-count">
          <view class="st-count-num">{{dataCounts.sessions}}</view>
          <view class="st-count-label">训练组</view>
        </view>
        <view class="st-count">
          <view class="st-count-num">{{dataCounts.questions}}</view>
          <view class="st-count-label">题目</view>
        </view>
        <view class="st-count">
          <view class="st-count-num">{{dataCounts.wrongQuestions}}</view>
          <view class="st-count-label">错题</view>
        </view>
        <view class="st-count">
          <view class="st-count-num">{{dataCounts.weakPatterns}}</view>
          <view class="st-count-label">薄弱点</view>
        </view>
      </view>

      <view class="st-act st-act-outline" hover-class="st-act-outline-hover" bindtap="resetSettings">
        恢复默认设置
      </view>
      <view class="st-act st-act-danger" hover-class="st-act-danger-hover" bindtap="clearAllData">
        清空所有训练数据
      </view>

    </view>
  </view>

  <!-- ============ 保存 ============ -->
  <view class="st-act st-act-primary st-act-foot" hover-class="st-act-primary-hover" bindtap="save">
    保存设置
  </view>

  <view class="st-footnote">{{savedHint || '修改会自动保存，无需手动点击'}}</view>

</view>
