<view class="page">
  <view class="page-header">
    <view>
      <view class="page-title">设置</view>
      <view class="page-subtitle">训练参数、薄弱点与 AI 配置</view>
    </view>
  </view>

  <!-- 训练参数 -->
  <view class="section">
    <view class="section-title">训练参数</view>
    <view class="card">
      <view class="field">
        <view class="field-label">默认模式</view>
        <picker range="{{['训练模式', '竞速模式']}}" value="{{defaultMode === 'speed' ? 1 : 0}}" bindchange="onModeChange">
          <view class="input" style="display: flex; align-items: center">{{defaultMode === 'speed' ? '竞速模式' : '训练模式'}}</view>
        </picker>
      </view>
      <view class="field">
        <view class="field-label">默认题目数量（{{questionCount}} 题）</view>
        <slider min="1" max="100" step="1" value="{{questionCount}}" bindchange="onQuestionCountChange" activeColor="#2f9e6b" />
      </view>
      <view class="field">
        <view class="field-label">默认允许误差（{{allowedErrorRate}}%）</view>
        <slider min="0" max="20" step="0.5" value="{{allowedErrorRate}}" bindchange="onErrorRateChange" activeColor="#2f9e6b" />
      </view>
    </view>
  </view>

  <!-- 薄弱点配置 -->
  <view class="section">
    <view class="section-title">薄弱点分析</view>
    <view class="card">
      <view class="field">
        <view class="field-label">启用薄弱点定向强化</view>
        <switch checked="{{weakEnable}}" bindchange="onWeakEnableChange" color="#2f9e6b" />
      </view>
      <view class="field">
        <view class="field-label">最小样本数（{{minSampleCount}} 题）</view>
        <slider min="5" max="50" step="1" value="{{minSampleCount}}" bindchange="onMinSampleChange" activeColor="#2f9e6b" />
      </view>
      <view class="field">
        <view class="field-label">最小错误数（{{minErrorCount}} 题）</view>
        <slider min="1" max="20" step="1" value="{{minErrorCount}}" bindchange="onMinErrorChange" activeColor="#2f9e6b" />
      </view>
      <view class="field">
        <view class="field-label">强化出题占比上限（{{maxReinforcementRatio}}%）</view>
        <slider min="0" max="90" step="5" value="{{maxReinforcementRatio}}" bindchange="onMaxRatioChange" activeColor="#2f9e6b" />
      </view>
    </view>
  </view>

  <!-- AI 配置 -->
  <view class="section">
    <view class="section-title">AI 解读</view>
    <view class="card">
      <view class="field">
        <view class="field-label">启用 AI 解读</view>
        <switch checked="{{aiEnabled}}" bindchange="onAiEnabledChange" color="#2f9e6b" />
      </view>
      <block wx:if="{{aiEnabled}}">
        <view class="field">
          <view class="field-label">接口地址</view>
          <input class="input" value="{{aiBaseUrl}}" bindinput="onAiBaseUrlInput" placeholder="https://api.deepseek.com" />
        </view>
        <view class="field">
          <view class="field-label">API Key</view>
          <input class="input" value="{{aiApiKey}}" bindinput="onAiApiKeyInput" password placeholder="sk-..." />
        </view>
        <view class="field">
          <view class="field-label">模型名称</view>
          <input class="input" value="{{aiModel}}" bindinput="onAiModelInput" placeholder="deepseek-chat" />
        </view>
        <view class="field">
          <view class="field-label">同意发送聚合统计</view>
          <switch checked="{{aiConsent}}" bindchange="onAiConsentChange" color="#2f9e6b" />
        </view>
        <view class="field-hint">AI 只接收聚合统计，不发送逐题答案。API Key 保存在本机。</view>
        <button class="btn btn-outline btn-block" bindtap="testAi" disabled="{{testing}}">{{testing ? '测试中…' : '测试连接'}}</button>
      </block>
    </view>
  </view>

  <!-- 数据管理 -->
  <view class="section">
    <view class="section-title">数据管理</view>
    <view class="card">
      <view wx:if="{{dataCounts}}" class="text-sm text-muted" style="margin-bottom: 16rpx">
        训练组 {{dataCounts.sessions}} · 题目 {{dataCounts.questions}} · 错题 {{dataCounts.wrongQuestions}} · 薄弱点 {{dataCounts.weakPatterns}}
      </view>
      <view class="btn-row">
        <button class="btn btn-outline" bindtap="resetSettings">恢复默认设置</button>
        <button class="btn btn-danger" bindtap="clearAllData">清空所有数据</button>
      </view>
    </view>
  </view>

  <!-- 保存 -->
  <button class="btn btn-primary btn-block" bindtap="save">保存设置</button>
</view>
