<view class="page">
  <view class="page-header">
    <view>
      <view class="page-title">基础计算</view>
      <view class="page-subtitle">先选好模式，再点题型即可直接开始</view>
    </view>
  </view>

  <view wx:if="{{errorMessage}}" class="alert alert-danger section">{{errorMessage}}</view>

  <!-- 训练模式选择（总开关，选好后各题型直接用该模式开始） -->
  <view class="section">
    <view class="section-title">训练模式</view>
    <view class="card">
      <view class="tabs" style="margin-bottom: 0">
        <button
          class="tab {{settings.defaultMode === 'training' ? 'active' : ''}}"
          data-mode="training"
          bindtap="switchMode"
        >练习模式</button>
        <button
          class="tab {{settings.defaultMode === 'speed' ? 'active' : ''}}"
          data-mode="speed"
          bindtap="switchMode"
        >竞速模式</button>
      </view>
      <view class="field-hint">{{modeDescription}}</view>
    </view>
  </view>

  <!-- 全部题型（点击直接用上方选好的模式开始） -->
  <view class="section">
    <view class="section-title">全部题型</view>
    <view class="topic-grid">
      <button
        wx:for="{{topics}}"
        wx:key="key"
        class="btn topic-btn {{item.available ? 'btn-outline topic-available' : 'btn-outline'}}"
        disabled="{{!item.available}}"
        data-key="{{item.key}}"
        bindtap="openTopic"
      >{{item.title}}</button>
    </view>
    <view class="field-hint" style="margin-top: 12rpx">点击已开放题型，直接以「{{modeLabel}}」开始训练（灰色题型即将上线）。</view>
  </view>

  <!-- 模块信息（次要入口） -->
  <view class="section">
    <view class="section-title">模块信息</view>
    <view class="card">
      <view class="list">
        <view class="list-item" data-page="five-divide-three" bindtap="goModuleInfo" hover-class="press-light">
          <view class="list-item-main">
            <view class="bold">五位数 ÷ 三位数</view>
            <view class="text-sm text-muted">配置 · 薄弱点强化范围 · 错题重练 · AI 诊断</view>
          </view>
          <text class="text-muted">›</text>
        </view>
        <view class="list-item" data-page="signed-add-sub" bindtap="goModuleInfo" hover-class="press-light">
          <view class="list-item-main">
            <view class="bold">正负运算</view>
            <view class="text-sm text-muted">配置 · 纯练习模块</view>
          </view>
          <text class="text-muted">›</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 薄弱点提示 -->
  <view class="section">
    <view class="section-title">薄弱点提示</view>
    <view wx:if="{{weakHint}}" class="card">
      <view class="text-sm" style="margin-bottom: 20rpx">{{weakHint}}</view>
      <button class="btn btn-secondary btn-block" data-page="weak" bindtap="goTo">查看薄弱点</button>
    </view>
    <view wx:else class="alert alert-info">暂无薄弱点，系统会持续分析你的错误分布</view>
  </view>

  <!-- 训练工具 -->
  <view class="section">
    <view class="section-title">训练工具</view>
    <view class="card">
      <view class="list">
        <view class="list-item" data-page="wrong" bindtap="goTo" hover-class="press-light">
          <view class="list-item-main">
            <view class="bold">📕 错题本</view>
            <view class="text-sm text-muted">未掌握 {{unmasteredWrongCount}} 题</view>
          </view>
          <text class="text-muted">›</text>
        </view>
        <view class="list-item" data-page="profile" bindtap="goTo" hover-class="press-light">
          <view class="list-item-main">
            <view class="bold">📈 训练记录</view>
            <view class="text-sm text-muted">历史统计与每日趋势</view>
          </view>
          <text class="text-muted">›</text>
        </view>
        <view class="list-item" data-page="weak" bindtap="goTo" hover-class="press-light">
          <view class="list-item-main">
            <view class="bold">🎯 薄弱点</view>
            <view class="text-sm text-muted">个人薄弱除数范围</view>
          </view>
          <text class="text-muted">›</text>
        </view>
        <view class="list-item" data-page="diagnosis" bindtap="goTo" hover-class="press-light">
          <view class="list-item-main">
            <view class="bold">◉ 能力诊断</view>
            <view class="text-sm text-muted">长期基线、近期变化与 AI 解读</view>
          </view>
          <text class="text-muted">›</text>
        </view>
      </view>
    </view>
  </view>

  <view wx:if="{{unmasteredWrongCount > 0 && !loading}}" class="section">
    <button class="btn btn-primary btn-block" bindtap="startWrongReview">错题重练（{{unmasteredWrongCount}} 题）</button>
    <view class="field-hint">错题重练会新建训练组并记录新的训练数据，不会修改历史记录。</view>
  </view>
</view>
