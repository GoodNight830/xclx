<view class="page">
  <view class="page-header">
    <view>
      <view class="page-title">基础计算</view>
      <view class="page-subtitle">先选好模式，再点题型即可直接开始</view>
    </view>
  </view>

  <view wx:if="{{errorMessage}}" class="alert alert-danger section">{{errorMessage}}</view>

  <!-- 训练模式选择（总开关，选好后各题型直接用该模式开始） -->
  <view class="section">
    <view class="section-title">训练模式</view>
    <view class="card">
      <view class="tabs" style="margin-bottom: 0">
        <button
          class="tab {{settings.defaultMode === 'training' ? 'active' : ''}}"
          data-mode="training"
          bindtap="switchMode"
        >练习模式</button>
        <button
          class="tab {{settings.defaultMode === 'speed' ? 'active' : ''}}"
          data-mode="speed"
          bindtap="switchMode"
        >竞速模式</button>
      </view>
      <view class="field-hint">{{modeDescription}}</view>
    </view>
  </view>

  <!-- 训练模块：点「开始训练」直接用上方选好的模式开始；支持 AI 的模块额外提供诊断入口 -->
  <view class="section">
    <view class="section-title">训练模块</view>

    <view wx:for="{{availableTopics}}" wx:key="key" class="card mod-card">
      <view class="card-title">{{item.title}}</view>
      <view wx:if="{{item.desc}}" class="text-sm text-muted" style="margin-top: 8rpx">{{item.desc}}</view>

      <view class="mod-actions">
        <view class="mod-act mod-act-primary" hover-class="mod-act-primary-hover" data-key="{{item.key}}" bindtap="openTopic">
          开始训练 · {{modeLabel}}
        </view>
        <view wx:if="{{item.aiSupported}}" class="mod-act mod-act-outline" hover-class="mod-act-outline-hover" data-key="{{item.key}}" bindtap="goModuleDiagnosis">
          AI 诊断
        </view>
      </view>
    </view>
  </view>

  <!-- 即将上线 -->
  <view class="section">
    <view class="section-title">即将上线</view>
    <view class="topic-grid">
      <view wx:for="{{upcomingTopics}}" wx:key="key" class="topic-soon">{{item.title}}</view>
    </view>
  </view>

  <!-- 薄弱点提示 -->
  <view class="section">
    <view class="section-title">薄弱点提示</view>
    <view wx:if="{{weakHint}}" class="card">
      <view class="text-sm" style="margin-bottom: 20rpx">{{weakHint}}</view>
      <button class="btn btn-secondary btn-block" data-page="weak" bindtap="goTo">查看薄弱点</button>
    </view>
    <view wx:else class="alert alert-info">暂无薄弱点，系统会持续分析你的错误分布</view>
  </view>

  <!-- 训练工具 -->
  <view class="section">
    <view class="section-title">训练工具</view>
    <view class="card">
      <view class="list">
        <view class="list-item" data-page="wrong" bindtap="goTo" hover-class="press-row">
          <view class="list-item-main">
            <view class="bold">📕 错题本</view>
            <view class="text-sm text-muted">未掌握 {{unmasteredWrongCount}} 题</view>
          </view>
          <text class="text-muted">›</text>
        </view>
        <view class="list-item" data-page="profile" bindtap="goTo" hover-class="press-row">
          <view class="list-item-main">
            <view class="bold">📈 训练记录</view>
            <view class="text-sm text-muted">历史统计与每日趋势</view>
          </view>
          <text class="text-muted">›</text>
        </view>
        <view class="list-item" data-page="weak" bindtap="goTo" hover-class="press-row">
          <view class="list-item-main">
            <view class="bold">🎯 薄弱点</view>
            <view class="text-sm text-muted">个人薄弱除数范围</view>
          </view>
          <text class="text-muted">›</text>
        </view>
        <view class="list-item" data-page="diagnosis" bindtap="goTo" hover-class="press-row">
          <view class="list-item-main">
            <view class="bold">◉ 能力诊断</view>
            <view class="text-sm text-muted">长期基线、近期变化与 AI 诊断入口</view>
          </view>
          <text class="text-muted">›</text>
        </view>
      </view>
    </view>
  </view>

  <view wx:if="{{unmasteredWrongCount > 0 && !loading}}" class="section">
    <button class="btn btn-primary btn-block" bindtap="startWrongReview">错题重练（{{unmasteredWrongCount}} 题）</button>
    <view class="field-hint">错题重练会新建训练组并记录新的训练数据，不会修改历史记录。</view>
  </view>
</view>
