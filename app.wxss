/**
 * 全局样式（迁移自 Web 版 main.css，精简为小程序 WXSS 语法）。
 * 移动优先，主色 #2f9e6b（绿色），配合浅色背景。
 */

page {
  background: #f2f6f2;
  color: #1f2430;
  font-size: 28rpx;
  line-height: 1.6;
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", "PingFang SC", "Hiragino Sans GB", sans-serif;
}

.page {
  padding: 24rpx;
  padding-bottom: 60rpx;
}

/* 页面标题 */
.page-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24rpx;
}
.page-title {
  font-size: 40rpx;
  font-weight: 700;
  margin: 0;
}
.page-subtitle {
  font-size: 26rpx;
  color: #8a93a6;
  margin: 8rpx 0 0;
}

/* 区块 */
.section {
  margin-bottom: 28rpx;
}
.section-title {
  font-size: 30rpx;
  font-weight: 700;
  margin: 0 0 16rpx;
}

/* 卡片 */
.card {
  background: #ffffff;
  border-radius: 20rpx;
  padding: 28rpx;
  box-shadow: 0 2rpx 12rpx rgba(31, 36, 48, 0.04);
}
.card-title {
  font-size: 30rpx;
  font-weight: 700;
  margin: 0;
}
.card-subtitle {
  font-size: 24rpx;
  color: #8a93a6;
  margin: 8rpx 0 0;
}

/* 按钮 */
.btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 0 32rpx;
  height: 88rpx;
  border-radius: 16rpx;
  font-size: 28rpx;
  font-weight: 600;
  border: 2rpx solid transparent;
  box-sizing: border-box;
  line-height: 1;
}
.btn::after { border: none; }
.btn-primary {
  background: #2f9e6b;
  color: #ffffff;
}
.btn-secondary {
  background: #eaf7f0;
  color: #2f9e6b;
}
.btn-outline {
  background: #ffffff;
  color: #2f9e6b;
  border-color: #bfe6d2;
}
.btn-ghost {
  background: transparent;
  color: #8a93a6;
}
.btn-danger {
  background: #fdecec;
  color: #ef4444;
}
.btn-block {
  width: 100%;
}
.btn-lg {
  height: 96rpx;
  font-size: 30rpx;
}
.btn-sm {
  height: 64rpx;
  font-size: 24rpx;
  padding: 0 24rpx;
}
.btn[disabled] {
  opacity: 0.5;
}

/* 行布局 */
.row-between {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.row {
  display: flex;
  align-items: center;
}
.btn-row {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  align-items: center;
}

/* 文本工具 */
.bold { font-weight: 700; }
.text-sm { font-size: 26rpx; }
.text-xs { font-size: 22rpx; }
.text-muted { color: #8a93a6; }
.text-success { color: #2f9e6b; }
.text-danger { color: #ef4444; }
.text-warning { color: #f59e0b; }
.text-center { text-align: center; }
.mono { font-family: "SF Mono", "Consolas", monospace; }

/* 列表 */
.list {
  display: flex;
  flex-direction: column;
}
.list-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 0;
  border-bottom: 2rpx solid #f0f2f7;
}
.list-item:last-child { border-bottom: none; }
.list-item-main {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
  flex: 1;
  min-width: 0;
}
.list-item-meta {
  font-size: 24rpx;
  color: #8a93a6;
}

/* 徽章 */
.badge {
  display: inline-flex;
  align-items: center;
  padding: 4rpx 16rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  font-weight: 600;
  background: #eef1f6;
  color: #4a5264;
}
.badge-success { background: #eaf7f0; color: #2f9e6b; }
.badge-warning { background: #fef4e6; color: #f59e0b; }
.badge-danger { background: #fdecec; color: #ef4444; }
.badge-muted { background: #eef1f6; color: #8a93a6; }

/* 提示 */
.alert {
  padding: 20rpx 24rpx;
  border-radius: 16rpx;
  font-size: 26rpx;
}
.alert-info {
  background: #eef4ff;
  color: #4f7cff;
}
.alert-danger {
  background: #fdecec;
  color: #ef4444;
}
.alert-success {
  background: #eaf7f0;
  color: #2f9e6b;
}

/* 表单 */
.field { margin-bottom: 20rpx; }
.field-label {
  display: block;
  font-size: 26rpx;
  color: #4a5264;
  font-weight: 600;
  margin-bottom: 8rpx;
}
.field-hint {
  font-size: 22rpx;
  color: #8a93a6;
  margin: 8rpx 0 0;
}
.input {
  width: 100%;
  height: 88rpx;
  padding: 0 24rpx;
  border-radius: 16rpx;
  border: 2rpx solid #e6e9f0;
  background: #ffffff;
  font-size: 28rpx;
  box-sizing: border-box;
}

/* 分段控件（tab） */
.tabs {
  display: flex;
  background: #eef1f6;
  border-radius: 16rpx;
  padding: 6rpx;
  margin-bottom: 20rpx;
}
.tab {
  flex: 1;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  color: #4a5264;
  border-radius: 12rpx;
  background: transparent;
}
.tab::after { border: none; }
.tab.active {
  background: #ffffff;
  color: #2f9e6b;
  font-weight: 600;
  box-shadow: 0 2rpx 8rpx rgba(31, 36, 48, 0.06);
}

/* 统计卡网格 */
.stat-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 16rpx;
}
.stat {
  background: #f8faf8;
  border-radius: 16rpx;
  padding: 20rpx;
}
.stat-label {
  font-size: 22rpx;
  color: #8a93a6;
}
.stat-value {
  font-size: 36rpx;
  font-weight: 700;
  color: #1f2430;
  margin-top: 4rpx;
}
.stat-value-sm { font-size: 30rpx; }

/* 分隔线 */
.divider {
  height: 2rpx;
  background: #f0f2f7;
  margin: 20rpx 0;
}

/* 空状态 */
.empty {
  padding: 60rpx 24rpx;
  text-align: center;
  color: #8a93a6;
  font-size: 26rpx;
}

/* 折叠面板 */
.collapse-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  width: 100%;
  background: transparent;
  padding: 0;
  border: none;
}
.collapse-header::after { border: none; }
.collapse-title { font-size: 30rpx; font-weight: 700; }
.collapse-meta { font-size: 24rpx; color: #8a93a6; display: flex; align-items: center; }
.collapse-chevron {
  display: inline-block;
  width: 16rpx;
  height: 16rpx;
  border-right: 3rpx solid #8a93a6;
  border-bottom: 3rpx solid #8a93a6;
  transform: rotate(45deg);
  transition: transform 0.2s;
  margin-left: 8rpx;
}
.collapse-chevron.open {
  transform: rotate(225deg);
}
.collapse-content { margin-top: 16rpx; }

/* 分类卡片（首页） */
.category-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 20rpx;
}
.category-card {
  background: #ffffff;
  border-radius: 20rpx;
  padding: 28rpx;
  box-shadow: 0 2rpx 12rpx rgba(31, 36, 48, 0.04);
}
.category-card-disabled { opacity: 0.5; }
.category-icon {
  font-size: 52rpx;
  margin-bottom: 12rpx;
}
.category-title {
  font-size: 30rpx;
  font-weight: 700;
}
.category-desc {
  font-size: 24rpx;
  color: #8a93a6;
  margin-top: 6rpx;
}

/* 饼状图圆点 */
.pie-dot {
  display: inline-block;
  width: 20rpx;
  height: 20rpx;
  border-radius: 50%;
  flex-shrink: 0;
}

/* 题目大字 */
.question-text {
  font-size: 34rpx;
  font-weight: 700;
  word-break: break-all;
}

/* 数字键盘 */
.keypad {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 16rpx;
}
.key {
  height: 108rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  font-weight: 600;
  background: #ffffff;
  border-radius: 16rpx;
  box-shadow: 0 2rpx 8rpx rgba(31, 36, 48, 0.06);
}
.key::after { border: none; }
.key-fn { color: #2f9e6b; font-size: 30rpx; }
.key-submit { background: #2f9e6b; color: #ffffff; }
