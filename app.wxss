/**
 * 全局样式 —— 微信小程序规范重写版
 *
 * 设计原则（针对小程序原生组件的特性）：
 * 1. 布局优先用 flex（view 上），但 button/text/input 等原生组件不依赖 flex 对齐。
 * 2. 按钮统一：display:block + line-height 垂直居中 + text-align:center。
 * 3. 网格一律 flex + flex-wrap + 百分比宽度（小程序不支持 CSS Grid / flex gap）。
 * 4. 文字用 view 包裹，避免 text 内嵌 flex。
 * 主色 #2f9e6b，浅色背景 #f5f7f6。
 */

page {
  background: #f5f7f6;
  color: #1f2430;
  font-size: 28rpx;
  line-height: 1.6;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Hiragino Sans GB", sans-serif;
}

.page {
  padding: 24rpx;
  padding-bottom: 60rpx;
  box-sizing: border-box;
}

/* ============ 页头 ============ */
.page-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24rpx;
}
.page-title {
  font-size: 40rpx;
  font-weight: 700;
  line-height: 1.3;
}
.page-subtitle {
  font-size: 24rpx;
  color: #8a93a6;
  margin-top: 6rpx;
}

/* ============ 区块 / 卡片 ============ */
.section {
  margin-bottom: 28rpx;
}
.section-title {
  font-size: 30rpx;
  font-weight: 700;
  margin-bottom: 16rpx;
}
.card {
  background: #ffffff;
  border-radius: 20rpx;
  padding: 28rpx;
  box-shadow: 0 4rpx 16rpx rgba(31, 36, 48, 0.05);
}
.card-title {
  font-size: 30rpx;
  font-weight: 700;
}
.card-subtitle {
  font-size: 24rpx;
  color: #8a93a6;
  margin-top: 8rpx;
}

/* ============ 按钮（原生 button，规范写法） ============
 * 微信 button 默认样式带 margin-left/right:auto，会把按钮推到居中/右侧。
 * 必须用 !important 强制归零，否则普通 margin: 0 优先级不够。
 */
.btn {
  display: block;
  box-sizing: border-box;
  margin: 0 !important;
  padding: 0 32rpx;
  height: 88rpx;
  line-height: 88rpx;
  text-align: center;
  border-radius: 16rpx;
  font-size: 28rpx;
  font-weight: 600;
  background-color: transparent;
  overflow: hidden;
  white-space: nowrap;
  border: none;
  width: auto;
}
.btn::after { border: none; }

/* ============ 点击反馈 ============ */
/* 微信 <button> 的默认 hover-class 名称固定为 "button-hover"，
 * 只要在 app.wxss 里定义这个类，全项目按钮自动获得按压效果，无需逐个改 wxml。
 * 加 !important 是为了覆盖微信内置基础样式。 */
.button-hover {
  opacity: 0.65 !important;
}

/* 可点击 view 的按压态（wxml 上加 hover-class="press-light"）。
 * view 的 hover-stay-time 默认 400ms，无需额外参数。 */
.press-light {
  background: #e6efea !important;
}

/* 可点击 view 的备用按压态：只降透明度，适合本身带底色的元素 */
.press-fade {
  opacity: 0.65;
}

.btn-primary { background: #2f9e6b; color: #ffffff; }
.btn-secondary { background: #eaf7f0; color: #2f9e6b; }
.btn-outline { background: #ffffff; color: #2f9e6b; border: 2rpx solid #bfe6d2; }
.btn-ghost { background: transparent; color: #8a93a6; }
.btn-danger { background: #fdecec; color: #ef4444; }

.btn-block { width: 100%; }
.btn-lg { height: 96rpx; line-height: 96rpx; font-size: 30rpx; }
.btn-sm { height: 64rpx; line-height: 64rpx; font-size: 24rpx; padding: 0 24rpx; }

.btn[disabled] { opacity: 0.4; }

/* 并排按钮一律使用 .topic-grid 容器（两列等宽），不再使用 btn-row */

/* ============ 通用行布局 ============ */
.row-between {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.row {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
}
.row > view,
.row > text,
.row > button {
  margin-right: 12rpx;
  margin-bottom: 6rpx;
}

/* ============ 文本工具 ============ */
.bold { font-weight: 700; }
.text-sm { font-size: 26rpx; }
.text-xs { font-size: 22rpx; }
.text-muted { color: #8a93a6; }
.text-success { color: #2f9e6b; }
.text-danger { color: #ef4444; }
.text-warning { color: #f59e0b; }
.text-center { text-align: center; }
.mono { font-family: "SF Mono", "Consolas", monospace; }

/* ============ 列表 ============ */
.list { }
.list-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 0;
  border-bottom: 2rpx solid #f0f2f7;
}
.list-item-main {
  flex: 1;
  min-width: 0;
}
.list-item-main > view,
.list-item-main > text {
  margin-bottom: 6rpx;
}
.list-item-meta {
  font-size: 24rpx;
  color: #8a93a6;
}

/* ============ 徽章 ============ */
.badge {
  display: inline-block;
  padding: 2rpx 16rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  font-weight: 600;
  background: #eef1f6;
  color: #4a5264;
  line-height: 1.5;
}
.badge-success { background: #eaf7f0; color: #2f9e6b; }
.badge-warning { background: #fef4e6; color: #f59e0b; }
.badge-danger { background: #fdecec; color: #ef4444; }
.badge-muted { background: #eef1f6; color: #8a93a6; }

/* ============ 提示 ============ */
.alert {
  padding: 20rpx 24rpx;
  border-radius: 16rpx;
  font-size: 26rpx;
}
.alert-info { background: #eef4ff; color: #4f7cff; }
.alert-danger { background: #fdecec; color: #ef4444; }
.alert-success { background: #eaf7f0; color: #2f9e6b; }

/* ============ 表单 ============ */
.field { margin-bottom: 24rpx; }
.field-label {
  display: block;
  font-size: 26rpx;
  color: #4a5264;
  font-weight: 600;
  margin-bottom: 8rpx;
}
.field-hint {
  font-size: 22rpx;
  color: #8a93a6;
  margin-top: 8rpx;
}
.input {
  box-sizing: border-box;
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  padding: 0 24rpx;
  border-radius: 16rpx;
  border: 2rpx solid #e6e9f0;
  background: #ffffff;
  font-size: 28rpx;
}

/* ============ 分段控件（tab） ============ */
.tabs {
  display: flex;
  background: #eef1f6;
  border-radius: 16rpx;
  padding: 6rpx;
  margin-bottom: 20rpx;
}
.tab {
  flex: 1;
  height: 64rpx;
  line-height: 64rpx;
  text-align: center;
  display: block;
  font-size: 26rpx;
  color: #4a5264;
  border-radius: 12rpx;
  background: transparent;
  margin: 0 !important;
  padding: 0;
}
.tab::after { border: none; }
.tab.active {
  background: #ffffff;
  color: #2f9e6b;
  font-weight: 600;
  box-shadow: 0 2rpx 8rpx rgba(31, 36, 48, 0.06);
}

/* ============ 2 列网格（flex 模拟 grid） ============ */
.stat-grid {
  display: flex;
  flex-wrap: wrap;
  margin-right: -16rpx;
  margin-bottom: -16rpx;
}
.stat {
  box-sizing: border-box;
  width: calc(50% - 16rpx);
  margin-right: 16rpx;
  margin-bottom: 16rpx;
  background: #f8faf8;
  border-radius: 16rpx;
  padding: 20rpx;
}
.stat-label {
  font-size: 22rpx;
  color: #8a93a6;
}
.stat-value {
  font-size: 36rpx;
  font-weight: 700;
  color: #1f2430;
  margin-top: 4rpx;
}
.stat-value-sm { font-size: 30rpx; }

/* ============ 分类卡片（首页 2 列） ============ */
.category-grid {
  display: flex;
  flex-wrap: wrap;
  margin-right: -20rpx;
  margin-bottom: -20rpx;
}
.category-card {
  box-sizing: border-box;
  width: calc(50% - 20rpx);
  margin-right: 20rpx;
  margin-bottom: 20rpx;
  background: #ffffff;
  border-radius: 20rpx;
  padding: 28rpx;
  box-shadow: 0 4rpx 16rpx rgba(31, 36, 48, 0.05);
}
.category-card-disabled { opacity: 0.5; }
.category-icon {
  font-size: 52rpx;
  margin-bottom: 12rpx;
  line-height: 1;
}
.category-title {
  font-size: 30rpx;
  font-weight: 700;
}
.category-desc {
  font-size: 24rpx;
  color: #8a93a6;
  margin-top: 6rpx;
}

/* ============ 题型按钮网格（basic 页） ============ */
.topic-grid {
  display: flex;
  flex-wrap: wrap;
  margin-right: -16rpx;
  margin-bottom: -16rpx;
}
.topic-btn {
  box-sizing: border-box;
  width: calc(50% - 16rpx);
  margin-right: 16rpx;
  margin-bottom: 16rpx;
}
.topic-available {
  background: #f4fbf7;
  color: #2f9e6b;
  border: 2rpx solid #bfe6d2;
}

/* ============ 数字键盘（3 列） ============ */
.keypad {
  display: flex;
  flex-wrap: wrap;
  margin-right: -16rpx;
  margin-bottom: -16rpx;
}
.key {
  box-sizing: border-box;
  width: calc(33.333% - 16rpx);
  height: 108rpx;
  margin-right: 16rpx;
  margin-bottom: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  font-weight: 600;
  background: #ffffff;
  border-radius: 16rpx;
  box-shadow: 0 4rpx 12rpx rgba(31, 36, 48, 0.06);
  color: #1f2430;
  line-height: 1;
}
.key-active {
  background: #e3efe8;
  box-shadow: none;
}
.key-fn {
  color: #2f9e6b;
  font-size: 30rpx;
  background: #eaf7f0;
}
.key-submit {
  background: #2f9e6b;
  color: #ffffff;
}

/* ============ 其他 ============ */
.divider {
  height: 2rpx;
  background: #f0f2f7;
  margin: 20rpx 0;
}
.empty {
  padding: 60rpx 24rpx;
  text-align: center;
  color: #8a93a6;
  font-size: 26rpx;
}
.pie-dot {
  display: inline-block;
  width: 20rpx;
  height: 20rpx;
  border-radius: 50%;
  flex-shrink: 0;
}
.question-text {
  font-size: 34rpx;
  font-weight: 700;
  word-break: break-all;
}

/* 折叠面板 */
.collapse-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  width: 100%;
}
.collapse-title { font-size: 30rpx; font-weight: 700; }
.collapse-meta {
  font-size: 24rpx;
  color: #8a93a6;
  display: flex;
  align-items: center;
}
.collapse-chevron {
  display: inline-block;
  width: 16rpx;
  height: 16rpx;
  border-right: 3rpx solid #8a93a6;
  border-bottom: 3rpx solid #8a93a6;
  transform: rotate(45deg);
  margin-left: 8rpx;
}
.collapse-chevron.open {
  transform: rotate(225deg);
}
.collapse-content { margin-top: 16rpx; }
